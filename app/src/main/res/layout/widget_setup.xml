<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when the app isn't onboarded yet (no profile / no balances) — avoids a misleading ₹0. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_glass"
    android:padding="16dp">

    <TextView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_glyph_bg"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="₹"
        android:fontFamily="@font/space_grotesk_bold"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_setup_title"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to open"
        android:fontFamily="@font/inter_medium"
        android:textColor="#FFD6CFF0"
        android:textSize="11sp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6" />
</LinearLayout>
