<?xml version="1.0" encoding="utf-8"?>
<!-- QUOTA — how much of the WEEK and MONTH budgets is spent, as a percentage and a bar. Deliberately
     carries no rupee amounts, no reset countdowns and no "today" row (scoped to exactly this).
     Header is the house row: launcher icon + "UPI ET" + refresh, same as widget_big. Default cell 2x1. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_glass"
    android:padding="10dp">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:text="@string/widget_brand"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#FFE6E1F9"
            android:textSize="11sp"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <ImageView
            android:id="@+id/refresh_btn"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- week row -->
    <LinearLayout
        android:id="@+id/week_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/week_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Week"
                android:textAllCaps="true"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.04"
                android:textColor="#FFE6E1F9"
                android:textSize="9sp"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/week_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0"
                android:fontFamily="@font/space_grotesk_bold"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="7" />

            <TextView
                android:id="@+id/week_pct_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:includeFontPadding="false"
                android:text="%"
                android:fontFamily="@font/space_grotesk_medium"
                android:textColor="#A8FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- One ProgressBar per band, visibility-swapped: RemoteViews can tint a bar but cannot swap a
             GRADIENT drawable, and the gradient is the point. Only one is ever VISIBLE. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp">

            <ProgressBar
                android:id="@+id/week_bar_calm"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/widget_quota_bar_calm" />

            <ProgressBar
                android:id="@+id/week_bar_near"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_quota_bar_near" />

            <ProgressBar
                android:id="@+id/week_bar_over"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_quota_bar_over" />
        </FrameLayout>
    </LinearLayout>

    <!-- month row -->
    <LinearLayout
        android:id="@+id/month_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/month_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Month"
                android:textAllCaps="true"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.04"
                android:textColor="#FFE6E1F9"
                android:textSize="9sp"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/month_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0"
                android:fontFamily="@font/space_grotesk_bold"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="7" />

            <TextView
                android:id="@+id/month_pct_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:includeFontPadding="false"
                android:text="%"
                android:fontFamily="@font/space_grotesk_medium"
                android:textColor="#A8FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- One ProgressBar per band, visibility-swapped: RemoteViews can tint a bar but cannot swap a
             GRADIENT drawable, and the gradient is the point. Only one is ever VISIBLE. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp">

            <ProgressBar
                android:id="@+id/month_bar_calm"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/widget_quota_bar_calm" />

            <ProgressBar
                android:id="@+id/month_bar_near"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_quota_bar_near" />

            <ProgressBar
                android:id="@+id/month_bar_over"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_quota_bar_over" />
        </FrameLayout>
    </LinearLayout>

    <!-- no caps set at all -->
    <TextView
        android:id="@+id/quota_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_quota_empty"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#A8FFFFFF"
        android:textSize="11sp"
        android:visibility="gone"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6" />
</LinearLayout>
