<?xml version="1.0" encoding="utf-8"?>
<!-- LARGE 4x4 — the only balance widget. Spend headline + masked balance + per-account split. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_glass"
    android:padding="14dp">

    <!-- top row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/widget_brand"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <ImageView
            android:id="@+id/spend_eye"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_widget_eye_open"
            android:contentDescription="Hide amounts" />

        <ImageView
            android:id="@+id/refresh_btn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- spend headline: three uniform columns — today / this week / this month -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textAllCaps="true"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.04"
                android:textColor="#FFE6E1F9"
                android:textSize="11sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/day_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:text="₹0"
                android:fontFamily="@font/space_grotesk_bold"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This week"
                android:textAllCaps="true"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.04"
                android:textColor="#FFE6E1F9"
                android:textSize="11sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/week_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:text="₹0"
                android:fontFamily="@font/space_grotesk_bold"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This month"
                android:textAllCaps="true"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.04"
                android:textColor="#FFE6E1F9"
                android:textSize="11sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/month_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:text="₹0"
                android:fontFamily="@font/space_grotesk_bold"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="7" />
        </LinearLayout>
    </LinearLayout>

    <!-- hairline -->
    <FrameLayout
        android:id="@+id/balance_hair"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp"
        android:background="#14FFFFFF" />

    <!-- balance row -->
    <LinearLayout
        android:id="@+id/balance_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/widget_live_dot"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available"
            android:fontFamily="@font/inter_medium"
            android:textColor="#FFE6E1F9"
            android:textSize="12sp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/balance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:includeFontPadding="false"
            android:text="₹●●,●●●"
            android:fontFamily="@font/space_grotesk_bold"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="7" />

        <LinearLayout
            android:id="@+id/eye_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="11dp"
            android:paddingEnd="13dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <ImageView
                android:id="@+id/eye_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_widget_eye_off"
                android:contentDescription="Reveal balance" />

            <TextView
                android:id="@+id/eye_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Reveal"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- per-account chips -->
    <LinearLayout
        android:id="@+id/balance_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/chip1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/chip1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDFC · at setup"
                android:fontFamily="@font/inter_medium"
                android:textColor="#FFEFEAFC"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5" />

            <TextView
                android:id="@+id/chip1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="₹●●,●●●"
                android:fontFamily="@font/space_grotesk_semibold"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/chip2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SBI · at setup"
                android:fontFamily="@font/inter_medium"
                android:textColor="#FFEFEAFC"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5" />

            <TextView
                android:id="@+id/chip2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="₹●●,●●●"
                android:fontFamily="@font/space_grotesk_semibold"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
