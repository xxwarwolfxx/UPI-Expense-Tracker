<?xml version="1.0" encoding="utf-8"?>
<!-- The "paused" glyph chip — the same shape as widget_glyph_bg but washed in the warn band
     (amber → coral), so a paused card reads as a warning at a glance, not as the brand. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#F6A037"
        android:endColor="#ED6266" />
    <corners android:radius="7dp" />
    <stroke
        android:width="1dp"
        android:color="#52FFFFFF" />
</shape>
